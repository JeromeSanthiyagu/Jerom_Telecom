# Copy to ".env" and fill in. .env is git-ignored - never commit real keys.

# LLM provider: "nvidia", "anthropic" or "offline" (deterministic templates only).
# Leave empty to pick automatically: nvidia if NVIDIA_API_KEY is set, else anthropic
# if ANTHROPIC_API_KEY is set, else offline.
LLM_PROVIDER=

# NVIDIA API Catalog (https://build.nvidia.com) - OpenAI-compatible endpoint
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning effort for reasoning models such as gpt-oss (default low: fastest, most reliable JSON)
# LLM_REASONING_EFFORT=low

# Anthropic (Claude) - optional alternative
ANTHROPIC_API_KEY=

# Model for the explanation and the LLM-as-judge
# (nvidia: openai/gpt-oss-20b, anthropic: claude-haiku-4-5)
LLM_MODEL=openai/gpt-oss-20b

# FastAPI: set WARMUP=0 to skip loading indexes at start-up
WARMUP=1
LOG_LEVEL=INFO

# Streamlit -> API
API_URL=http://localhost:8000

# Optional: avoid Hugging Face network checks once the embedding model is cached
# HF_HUB_OFFLINE=1
